# ============================================
# AACT Platform — متغيرات البيئة
# انسخ هذا الملف إلى .env ثم عدّل القيم عند الحاجة.
# ============================================

# قاعدة البيانات PostgreSQL — يفضل Neon على Vercel
# DATABASE_URL: رابط Neon مع Connection Pooling وفيه -pooler
# DIRECT_URL: رابط Neon المباشر بدون -pooler، مفيد للأدوات والهجرات إن احتجته لاحقاً
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"

# تخزين الملفات خارج قاعدة البيانات — Cloudflare R2 أو AWS S3 أو أي S3-compatible storage
# في الإنتاج يجب ضبط هذه القيم حتى لا تُخزن الكتب والمستندات داخل قاعدة البيانات.
AACT_S3_ENDPOINT=""
AACT_S3_BUCKET=""
AACT_S3_REGION="auto"
AACT_S3_ACCESS_KEY_ID=""
AACT_S3_SECRET_ACCESS_KEY=""
# اختياري: نطاق عام للحاوية/الباكت مثل https://files.your-domain.com
AACT_STORAGE_PUBLIC_BASE_URL=""
# للتجارب المحلية فقط. لا تفعله في الإنتاج إلا إذا كنت تقبل تخزين الملفات محلياً مؤقتاً.
AACT_ALLOW_LOCAL_UPLOADS="false"

# رابط الموقع المنشور — مهم لـ Google OAuth والروابط الرسمية
NEXTAUTH_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXTAUTH_SECRET="change-this-long-random-secret"

# أمان الإنتاج
# لا تجعلها 1 في الإنتاج إلا لأغراض صيانة مؤقتة جداً.
AACT_AUTO_SEED_ON_LOGIN="0"
AACT_ENABLE_DEMO_LOGIN="0"
# لا تستخدمه في الإنتاج إلا مرة واحدة عند تهيئة قاعدة جديدة عن قصد.
AACT_RUN_SEED="NO"
AACT_BOOTSTRAP_DEFAULT_ADMIN="0"
# يطلبه db:force-push فقط، ولا يستخدم في النشر العادي.
AACT_CONFIRM_DATA_LOSS="NO"
# إنشاء أول مدير بدون بيانات تجريبية: فعّلها مؤقتاً وشغل bun run admin:create ثم أعدها NO.
AACT_CREATE_ADMIN="NO"
AACT_ADMIN_EMAIL="admin@your-domain.com"
AACT_ADMIN_PASSWORD="change-this-very-strong-password"
AACT_ADMIN_NAME="إدارة الأكاديمية"
# حماية الدفع التجريبي: اتركها false في الإنتاج. فعّلها فقط في بيئة اختبار مقصودة.
AACT_ALLOW_SANDBOX_PAYMENTS_IN_PRODUCTION="false"

# الإشعارات البريدية عبر Resend — الموصى به للإنتاج
RESEND_API_KEY=""
MAIL_FROM="AACT <notifications@your-domain.com>"
RESEND_FROM=""

# بوابات الدفع الحقيقية
PAYMENT_MODE="LIVE"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""
PAYPAL_API_BASE="https://api-m.paypal.com"

# Google Login — من Google Cloud Console
# Authorized redirect URI:
# https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Gemini / AI
GEMINI_API_KEY=""
# تحليل الكتب وبنك المعرفة يبقى نصياً/تحليلياً، وليس Live
GEMINI_TEXT_MODEL="gemini-3.8-flash"
GEMINI_TTS_MODEL="gemini-3.1-flash-tts-preview"
GEMINI_TTS_VOICE="Kore"
# المشرف الصوتي المباشر: سريع ومنخفض التأخير
GEMINI_SUPERVISOR_LIVE_MODEL="gemini-3.8-live"
# المناقشة والدفاع: Live مع تفكير أعمق
GEMINI_DISCUSSION_LIVE_MODEL="gemini-3.8-live-extended-thinking"
GEMINI_DISCUSSION_THINKING_LEVEL="high"

# مزود النصوص الخارجي — اختياري، ولا يؤثر على Gemini Live أو الصوت
# القيم: GEMINI | AUTO | OPENAI | ANTHROPIC | ZAI
AI_TEXT_PROVIDER="GEMINI"
OPENAI_API_KEY=""
OPENAI_TEXT_MODEL="gpt-5.1"
OPENAI_BASE_URL="https://api.openai.com/v1"
ANTHROPIC_API_KEY=""
ANTHROPIC_TEXT_MODEL="claude-sonnet-4-5-20250929"
ZAI_API_KEY=""
ZAI_TEXT_MODEL="glm-4.5"
ZAI_API_BASE="https://api.z.ai/api/paas/v4"
