# ============================================
# AACT Platform — متغيرات البيئة
# انسخ هذا الملف إلى .env ثم عدّل القيم عند الحاجة.
# ============================================

# قاعدة البيانات PostgreSQL — يفضل Neon على Vercel
# DATABASE_URL: رابط Neon مع Connection Pooling وفيه -pooler
# DIRECT_URL: رابط Neon المباشر بدون -pooler، مفيد للأدوات والهجرات إن احتجته لاحقاً
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"

# رابط الموقع المنشور — مهم لـ Google OAuth والروابط الرسمية
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="change-this-long-random-secret"

# Google Login — من Google Cloud Console
# Authorized redirect URI:
# https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Gemini / AI
GEMINI_API_KEY=""
# تحليل الكتب وبنك المعرفة يبقى نصياً/تحليلياً، وليس Live
GEMINI_TEXT_MODEL="gemini-3.8-flash"
GEMINI_TTS_MODEL="gemini-3.1-flash-tts-preview"
GEMINI_TTS_VOICE="Kore"
# المشرف الصوتي المباشر: سريع ومنخفض التأخير
GEMINI_SUPERVISOR_LIVE_MODEL="gemini-3.8-live"
# المناقشة والدفاع: Live مع تفكير أعمق
GEMINI_DISCUSSION_LIVE_MODEL="gemini-3.8-live-extended-thinking"
GEMINI_DISCUSSION_THINKING_LEVEL="high"
