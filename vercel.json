{
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "framework": "nextjs",
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"production\" ] || { [ \"$VERCEL_ENV\" = \"preview\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" = \"fix/seo-canonical-404-indexing\" ]; }; then exit 1; else exit 0; fi",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/book-read-jobs",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/question-bank-jobs",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/ai-health",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/ai-retention",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/lecture-reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/student-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/admin-message-digest",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/academic-lifecycle",
      "schedule": "*/15 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "fix/seo-canonical-404-indexing": true,
      "*": false
    }
  }
}
