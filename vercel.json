{
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "framework": "nextjs",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/book-read-jobs",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/question-bank-jobs",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/ai-health",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/ai-retention",
      "schedule": "15 3 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  }
}
